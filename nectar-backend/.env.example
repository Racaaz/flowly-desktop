# ============ KONEKSI DATABASE (XAMPP) ============
# Gunakan 127.0.0.1, BUKAN "localhost" (menghindari masalah IPv6 di Windows)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Default XAMPP: password root KOSONG
DB_PASSWORD=
DB_NAME=nectar_desktop

# ============ SERVER ============
PORT=4000
# 127.0.0.1 = hanya bisa diakses dari laptop Anda sendiri (paling aman)
HOST=127.0.0.1

# Alamat frontend yang boleh memanggil API ini (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Zona waktu untuk menentukan "hari ini" (WIB)
APP_TZ=Asia/Jakarta

# OPSIONAL: kalau diisi, setiap request wajib menyertakan header x-api-key
# dengan nilai yang sama. Kosongkan kalau hanya dipakai lokal.
API_KEY=
